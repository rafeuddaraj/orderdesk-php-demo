# For shared hosting, where the document root cannot point at public/.
# Only public/ is served; app code, data, logs and config stay private.
RewriteEngine On

RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteRule ^(app|database|logs|sessions)(/|$) - [F,L]
RewriteRule ^(config\.php|config\.example\.php|README\.md)$ - [F,L]
RewriteRule ^\. - [F,L]

RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
